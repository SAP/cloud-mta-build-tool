#!/usr/bin/env node
var path = require("path");
var spawn = require("child_process").spawn;

var os = process.platform;
var arch = process.arch;
var binExt = os === "win32" ? ".exe" : "";

var pkgName = "@sap/mbt-" + os + "-" + arch;
var binPath;
try {
  binPath = path.join(
    path.dirname(require.resolve(pkgName + "/package.json")),
    "mbt" + binExt
  );
} catch (e) {
  console.error(
    "Could not find the mbt binary for your platform (" + os + "/" + arch + ").\n" +
    "Expected package: " + pkgName + "\n" +
    "Try reinstalling @sap/mbt."
  );
  process.exit(1);
}

spawn(binPath, process.argv.slice(2), { stdio: "inherit" }).on("exit", process.exit);
